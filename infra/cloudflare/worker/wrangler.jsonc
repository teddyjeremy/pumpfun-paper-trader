{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pumpfun-paper-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "vars": {
    "PUMPFUN_PROGRAM_ID": "6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P",
    "PAPER_EVENT_INGEST_URL": "https://pumpfun-paper-trader-six.vercel.app",
    "FULL_WALLET_HISTORY_ENABLED": "false",
    "FULL_WALLET_HISTORY_MAX_PAGES": "2"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "PumpFunCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PumpFunCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}

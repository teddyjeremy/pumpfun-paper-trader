NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=change-this-to-a-long-random-secret
DATABASE_URL=
HELIUS_API_KEY=
PUMPFUN_MODE=paper
PAPER_STARTING_BALANCE_USD=2.70
PAPER_POSITION_SIZE_USD=1.00
PAPER_MAX_OPEN_POSITIONS=1
DIAGNOSTICS_RETENTION_HOURS=24
DYNAMIC_EXIT_ENABLED=true
DYNAMIC_EXIT_CONFIRMATION_WINDOWS=2
DYNAMIC_EXIT_MIN_BEARISH_SIGNALS=2
DYNAMIC_EXIT_BUY_SELL_RATIO_BELOW=1
DYNAMIC_EXIT_BUY_VOLUME_DECLINE_PCT=40
DYNAMIC_EXIT_BUYER_RATE_DECLINE_PCT=40
DYNAMIC_EXIT_SELL_VOLUME_EXPANSION_PCT=50
DYNAMIC_EXIT_PRICE_RESPONSE_DECLINE_PCT=40
DYNAMIC_EXIT_LIQUIDITY_DROP_PCT=20
# Set this base URL in the Cloudflare Worker; the same token is a Worker secret.
PAPER_EVENT_INGEST_URL=
PAPER_EVENT_INGEST_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Optional: server-side Cloudflare Worker status/control proxy. Never expose token in browser.
PAPER_WORKER_URL=
PAPER_WORKER_CONTROL_TOKEN=
